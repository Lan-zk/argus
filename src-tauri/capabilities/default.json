{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "http://**"
        },
        {
          "url": "https://*:*"
        },
        {
          "url": "http://*:*"
        }
      ]
    },
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "dialog:allow-open",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "updater:default",
    "process:allow-restart"
  ]
}